PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/bidsync
JWT_SECRET=change-me

# One origin, or several separated by commas (production + preview URLs).
CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Enables precise auction closing with BullMQ.
# Without it, the 1-minute cron sweeper closes auctions.
REDIS_URL=

# Optional. Minutes added when a bid lands near the end (0 = off).
ANTI_SNIPE_MINUTES=2

# Optional. Number of proxies in front of the server (Render = 1).
TRUST_PROXY=1

# Only for load tests. Never in production.
# RATE_LIMIT_DISABLED=true
